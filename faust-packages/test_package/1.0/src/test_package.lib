// x package public API

import("stdfaust.lib");
import("helpers.lib");

// Basic test signal builder using explicit switches.
x_test_signal(freq, sine_on, white_on, pink_on) =
    os.osc(freq) * sine_on
    + no.noise * white_on
    + x_pink(no.noise) * ba.db2linear(20) * pink_on;

// Route a mono signal to 8 outputs based on integer destination.
x_route8(dest, sig) = sig <: par(i, 8, *(dest == i));

// Full tester chain from UI values (gain, destination) and switches.
x_tester(freq, vol_db, dest, sine_on, white_on, pink_on) =
    x_route8(dest, x_test_signal(freq, sine_on, white_on, pink_on) * x_gain_db(vol_db));